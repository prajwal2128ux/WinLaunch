# WinLaunch Environment Configuration
# Copy this file to .env for local overrides if needed.

# Application Environment ('development' or 'production')
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# Optional: Google Gemini API Key (if enabling AI website categorization & summaries)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# Optional: Public URL if deploying web app or backend on a custom domain
APP_URL=

# Optional: Custom directory for storing SQLite database and cloud accounts
# Defaults to %APPDATA%/WinLaunch/ on Windows or ./data/ in development mode
# WINLAUNCH_DATA_DIR=

