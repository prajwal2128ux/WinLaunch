{
  "name": "winlaunch",
  "version": "1.0.0",
  "description": "Modern Windows website launcher and bookmark manager to save, organize, and launch websites in Google Chrome with local SQLite storage and account synchronization.",
  "private": false,
  "license": "MIT",
  "author": "WinLaunch Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/winlaunch/winlaunch.git"
  },
  "keywords": [
    "windows",
    "electron",
    "launcher",
    "chrome",
    "sqlite",
    "bookmarks",
    "dashboard"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "clean": "rm -rf dist dist_electron server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
